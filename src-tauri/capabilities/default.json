{
  "$schema": "../gen/schemas/capability.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "sidecar": "binaries/yt-dlp"
        },
        {
          "sidecar": "binaries/ffmpeg"
        }
      ]
    },
    "shell:default"
  ]
}